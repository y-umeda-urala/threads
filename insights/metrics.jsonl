{"id": "p-2026090508-b1m7", "post_id": "18120850574317999", "posted_at": "2026-09-05T23:01:03.396065+00:00", "date": "2026-09-06", "hour": 8, "text_len": 70, "has_thread": true, "first_line": "福井で仕事をしていて助かっているのは、移動時間の短さです。", "opening": "説明文", "note": "", "permalink": "https://www.threads.com/@urala._.fukui/post/Dc7F6xbj3N9", "measured_at": "2026-09-07T17:28:33.688877+09:00", "views": 1084, "likes": 16, "replies": 1, "reposts": 0, "quotes": 0, "bookmarks": 0, "eng": 17, "length_bucket": "短（〜80字）"}
